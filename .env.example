NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade legada; a publishable tem prioridade.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Alternativa legada à secret key, somente no servidor:
SUPABASE_SERVICE_ROLE_KEY=
# Teste de expiração apenas com npm run dev (ignorados em produção):
NEXT_PUBLIC_DNA_PROMOTION_TEST_START_AT=
NEXT_PUBLIC_DNA_PROMOTION_TEST_END_AT=
NEXT_PUBLIC_SITE_URL=https://dnadoacai.com.br
WHATSAPP_BUSINESS_PHONE_NUMBER=5562991102715
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE_NAME=pedido_recebido
QZ_CERTIFICATE=
QZ_PRIVATE_KEY=
# Atendimento automático pelo WhatsApp (AtendeIA) — somente servidor. Vazio = integração desligada (503).
# Segredo HMAC compartilhado (>= 32 caracteres), o mesmo cadastrado em AtendeIA > Pedidos.
ATENDEIA_INTEGRATION_SECRET=
# (opcional) URL de status exibida em AtendeIA > Pedidos; avisa o cliente quando o status do pedido muda.
ATENDEIA_STATUS_WEBHOOK_URL=
